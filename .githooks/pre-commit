#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v python >/dev/null 2>&1; then
  python tools/sanitize_notebooks.py --staged
elif command -v py >/dev/null 2>&1; then
  py -3 tools/sanitize_notebooks.py --staged
else
  echo "pre-commit: Python is required to sanitize notebooks." >&2
  exit 1
fi
