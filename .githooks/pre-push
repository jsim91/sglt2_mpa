#!/usr/bin/env sh
# Check pushed notebooks for secrets only. Outputs/figures remain intact on GitHub.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

remote="$1"
stdin_data=$(cat)

if command -v python >/dev/null 2>&1; then
  printf '%s' "$stdin_data" | python tools/sanitize_notebooks.py --check-push-secrets "$remote"
elif command -v py >/dev/null 2>&1; then
  printf '%s' "$stdin_data" | py -3 tools/sanitize_notebooks.py --check-push-secrets "$remote"
fi
